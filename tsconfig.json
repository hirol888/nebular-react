{
  "extends": "./tsconfig.base.json",
  "include": [
    "src/nebular-react-*/src",
    "./types",
    "./docs/src",
    "./scripts",
    "./configuration",
    "./configuration/types",
    "./tests",
    "./e2e",
    "./playwright.config.ts"
  ],
  "exclude": [
    "public",
    ".cache",
    "configuration/jest",
    "configuration/storybook/main.js",
    "node_modules",
    "src/nebular-react-*/esm/**/*",
    "src/nebular-react-*/lib/**/*",
    "src/nebular-react-*/lib-cjs/**/*",
    "src/nebular-react-*/cjs/**/*"
  ],
  "compilerOptions": {
    "types": ["node", "jest", "@testing-library/jest-dom", "jest-axe"],
    "paths": {
      "@nebular-react/*": ["./src/nebular-react-*/src"]
    }
  }
}
