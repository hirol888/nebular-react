{
  "extends": "../../tsconfig.base.json",
  "include": ["./src"],
  "exclude": [
    "./lib",
    "./lib-cjs",
    "./esm",
    "./cjs",
    "**/*.story.tsx",
    "**/*.test.tsx",
    "**/*.test.ts"
  ],
  "compilerOptions": {
    "noEmit": true,
    "strictNullChecks": true,
    "paths": {
      "@nebular-react/ssr": ["./../nebular-react-ssr/src"],
      "@nebular-react/styles": ["./../nebular-react-styles/src"]
    }
  }
}
