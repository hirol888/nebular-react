{
  "name": "@nebular-react/ssr",
  "description": "Nebular server side rendering utils",
  "version": "1.0.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "cjs/index.js",
  "module": "esm/index.js",
  "types": "lib/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./esm/index.js"
      },
      "require": {
        "types": "./lib-cjs/index.d.cts",
        "default": "./cjs/index.js"
      },
      "default": "./cjs/index.js"
    },
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "files": [
    "cjs",
    "esm",
    "lib",
    "lib-cjs"
  ],
  "license": "MIT",
  "author": "Huining Li <hiro.l.dragon@gmail.com>",
  "sideEffects": false,
  "homepage": "https://github.com/hirol888/nebular-react",
  "repository": {
    "url": "git+https://github.com/hirol888/nebular-react.git",
    "type": "git",
    "directory": "src/nebular-react-ssr"
  },
  "keywords": [
    "react",
    "next",
    "nextjs",
    "gatsby",
    "gatsbyjs",
    "ssr",
    "server",
    "server-side",
    "server-side-rendering",
    "render"
  ],
  "peerDependencies": {
    "react": ">=19.2.0",
    "react-dom": ">=19.2.0",
    "@emotion/react": ">=11.14.0",
    "@emotion/server": ">=11.11.0"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@nebular-react/styles": "1.0.0",
    "html-react-parser": "^6.1.10"
  },
  "devDependencies": {},
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
