{
  "extends": "../../tsconfig.base.json",
  "include": ["./src", "../../configuration/types"],
  "exclude": [
    "./lib",
    "./esm",
    "./cjs",
    "**/*.story.tsx",
    "**/*.test.tsx",
    "**/*.test.ts",
    "**/styles.api.ts",
    "src/components/*/demos/*",
    "src/demos.ts"
  ],
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib",
    "declaration": true,
    "declarationMap": true,
    "declarationDir": "lib",
    "composite": true,
    "paths": {
      "@nebular-react/hooks": ["../nebular-react-hooks/src"],
      "@nebular-react/styles": ["../nebular-react-styles/src"]
    }
  },
  "references": [{ "path": "../nebular-react-hooks" }, { "path": "../nebular-react-styles" }]
}
