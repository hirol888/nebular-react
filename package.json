{
  "name": "nebular-react",
  "private": true,
  "workspaces": [
    "src/*"
  ],
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "Nebular React Components Monorepo",
  "main": "index.js",
  "repository": "https://github.com/hirol888/nebular-react",
  "author": "Huining Li <nebularreact@gmail.com>",
  "license": "MIT",
  "scripts": {
    "syncpack": "syncpack lint --dependency-types prod,dev,peer",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit && yarn typecheck:hooks && yarn typecheck:styles && yarn typecheck:ssr && yarn typecheck:core && yarn typecheck:next",
    "typecheck:hooks": "node ./node_modules/@typescript/native/bin/tsc --noEmit -p src/nebular-react-hooks/tsconfig.strict.json",
    "typecheck:styles": "node ./node_modules/@typescript/native/bin/tsc --noEmit -p src/nebular-react-styles/tsconfig.strict.json",
    "typecheck:ssr": "node ./node_modules/@typescript/native/bin/tsc --noEmit -p src/nebular-react-ssr/tsconfig.strict.json",
    "typecheck:core": "node ./node_modules/@typescript/native/bin/tsc --noEmit -p src/nebular-react-core/tsconfig.strict.json",
    "typecheck:next": "node ./node_modules/@typescript/native/bin/tsc --noEmit -p src/nebular-react-next/tsconfig.strict.json",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "e2e": "yarn build-storybook && playwright test",
    "e2e:update": "yarn build-storybook && playwright test --update-snapshots",
    "e2e:install": "playwright install chromium",
    "prebuild": "yarn clean",
    "build": "esno scripts/build all",
    "prebuild:all": "yarn clean",
    "build:all": "esno scripts/build all",
    "jest": "jest",
    "coverage": "jest --coverage --maxWorkers=2",
    "prettier:test": "prettier --check \"src/**/*.{ts,tsx}\"",
    "prettier:write": "prettier --write \"src/**/*.{ts,tsx}\"",
    "exports": "esno scripts/check-exports",
    "conflicts": "esno scripts/check-conflicts",
    "lint:package": "publint --pack npm src/nebular-react-core && publint --pack npm src/nebular-react-hooks && publint --pack npm src/nebular-react-styles && publint --pack npm src/nebular-react-ssr && publint --pack npm src/nebular-react-next",
    "lint:types": "attw --pack src/nebular-react-core --profile node16 && attw --pack src/nebular-react-hooks && attw --pack src/nebular-react-styles && attw --pack src/nebular-react-ssr && attw --pack src/nebular-react-next",
    "clean": "rimraf --glob \"src/*/esm\" \"src/*/cjs\" \"src/*/lib\" \"src/*/lib-cjs\" \"src/*/dist\" \"src/**/*.tsbuildinfo\"",
    "storybook": "esno scripts/storybook-start",
    "build-storybook": "storybook build -c .storybook -o storybook-static",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "node scripts/apply-changesets.mjs && prettier --write \"src/*/CHANGELOG.md\" && yarn install --ignore-scripts",
    "release": "yarn build:all && changeset publish",
    "test": "yarn prettier:test && yarn syncpack && yarn typecheck && yarn lint && yarn jest",
    "_release:no-test": "esno scripts/release",
    "_release": "yarn release:prepare && esno scripts/release",
    "_release:alpha": "yarn _release minor -- --stage alpha --tag next",
    "_release:alpha:major": "yarn _release:no-test major -- --stage alpha --tag next",
    "release:prepare": "yarn clean && yarn test",
    "release:patch": "yarn _release patch",
    "release:minor": "yarn _release minor",
    "release:major": "yarn _release major"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@changesets/pre": "^3.0.0",
    "@changesets/read": "^1.0.1",
    "@js-temporal/polyfill": "^0.5.1",
    "@playwright/test": "^1.65.1",
    "@rollup/plugin-alias": "^6.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/react-webpack5": "10.6.7",
    "@sucrase/jest-plugin": "^3.0.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/lodash": "^4.17.27",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yargs": "^17.0.35",
    "@typescript/native": "npm:typescript@^7.0.2",
    "chalk": "^6.0.1",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "esbuild": "^0.28.2",
    "esbuild-loader": "^4.5.0",
    "eslint": "^9.39.5",
    "eslint-config-airbnb-extended": "^3.3.0",
    "eslint-config-prettier": "^10.1.8",
    "esno": "^4.8.0",
    "execa": "^10.2.1",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.4.1",
    "is-directory": "^0.3.1",
    "jest": "^30.5.2",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.5.2",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "new-github-release-url": "^2.0.0",
    "next": ">=15.5.0 <17",
    "open": "^11.0.4",
    "prettier": "^3.10.1",
    "publint": "^0.3.25",
    "rimraf": "^6.1.4",
    "rollup": "^4.68.7",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-node-externals": "^9.0.1",
    "rollup-plugin-visualizer": "^7.1.3",
    "simple-git": "^4.1.0",
    "storybook": "10.6.7",
    "sucrase": "^3.35.1",
    "syncpack": "^15.3.3",
    "typescript": "^6.0.3",
    "webpack": "^5.112.2",
    "yargs": "^18.2.0"
  },
  "dependencies": {
    "@emotion/react": ">=11.14.0",
    "@emotion/server": ">=11.11.0",
    "react": ">=19.2.0",
    "react-dom": ">=19.2.0"
  }
}
